[Unit]
Description=私语聊天室
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=chat
StateDirectory=chat
WorkingDirectory=/var/lib/chat
ExecStart=/usr/local/bin/chat-server serve
Restart=on-failure
RestartSec=3
UMask=0077

Environment=CHAT_DATA_DIR=/var/lib/chat
Environment=CHAT_LISTEN=127.0.0.1:8080
Environment=CHAT_PUBLIC_BASE_URL=https://chat.example.com
LoadCredential=master.key:/etc/chat/master.key
Environment=CHAT_MASTER_KEY_FILE=%d/master.key

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes
RemoveIPC=yes
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=300M
CPUQuota=60%

[Install]
WantedBy=multi-user.target
