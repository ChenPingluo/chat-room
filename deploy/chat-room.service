[Unit]
Description=私密聊天室
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatroom
Group=chatroom
ExecStart=/usr/local/bin/chat-room serve --data-dir /var/lib/chat-room --public-url https://chat.example.com
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=chat-room
StateDirectoryMode=0700
WorkingDirectory=/var/lib/chat-room
LoadCredential=master.key:/etc/chat-room/master.key
MemoryHigh=200M
MemoryMax=300M
TasksMax=256
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
